# Copy to .env and fill in. On cPanel these can also be set with
# SetEnv directives in .htaccess.
#
# Nothing here may be committed with real values.

APP_DEBUG=false
APP_URL=https://mktr.co.id

# Subdirectory the rebuilt app is served from, without a trailing slash.
# '/v2' while it runs alongside the legacy site; empty after cutover.
APP_BASE_PATH=/v2

# Signs session fingerprints and preview tokens. Generate a unique value:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Set only when connecting through a unix socket instead of TCP.
DB_SOCKET=

# Read-only connection to the legacy database, used by database/import/.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
